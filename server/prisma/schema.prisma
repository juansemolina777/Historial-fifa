// Prisma schema para Historial FIFA

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  passwordHash String?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())

  matchesA Match[] @relation("PlayerA")
  matchesB Match[] @relation("PlayerB")

  tournamentParticipants TournamentParticipant[]
  friendshipsAsUser1     Friendship[] @relation("FriendshipUser1")
  friendshipsAsUser2     Friendship[] @relation("FriendshipUser2")
}

model Tournament {
  id        String   @id @default(cuid())
  name      String
  year      Int
  createdAt DateTime @default(now())

  matches      Match[]
  participants TournamentParticipant[]
}

enum MatchType {
  TORNEO
  AMISTOSO
}

model Match {
  id   String    @id @default(cuid())
  type MatchType

  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])

  playerAId String
  playerA   User   @relation("PlayerA", fields: [playerAId], references: [id])

  playerBId String
  playerB   User   @relation("PlayerB", fields: [playerBId], references: [id])

  scoreA    Int
  scoreB    Int
  playedAt  DateTime
  createdAt DateTime @default(now())

  @@index([type, playedAt])
  @@index([tournamentId])
  @@index([playerAId, playerBId])
}

model TournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model Friendship {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1 User @relation("FriendshipUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("FriendshipUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}
